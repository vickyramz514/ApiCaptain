# Shared
NODE_ENV=development

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/apicaptain?schema=public

# API (apps/api)
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Web (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
