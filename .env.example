# Shared
NODE_ENV=development

# PostgreSQL (Prisma)
# Local example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/apicaptain?schema=public
#
# Railway (from your laptop): use the PUBLIC URL (host like *.proxy.rlwy.net)
# Append: ?sslmode=require&connect_timeout=60&schema=public
# Example:
# DATABASE_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway?sslmode=require&connect_timeout=60&schema=public
#
# Railway (API service on Railway): use the INTERNAL URL (*.railway.internal)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/apicaptain?schema=public

# API (apps/api)
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
BODY_LIMIT=2mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
AUTH_SECRET=replace-with-a-long-random-string
APP_URL=http://localhost:3000
SESSION_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=60

# Billing (Razorpay) — never commit real secrets
# Production uses the DataCaptain Razorpay account + this Pro plan.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_PLAN_ID=plan_TUqfD25EhbbXAo
# BILLING_PROVIDER=razorpay
# BILLING_PROVIDER=mock

# Optional: force in-memory SaaS store (tests / no DB)
# SAAS_STORE=memory

# Google Sign-In — same OAuth client as DataCaptain (CinePrompt)
# Client ID is public (used in the browser). Do not commit GOOGLE_CLIENT_SECRET.
# Add this app's origins in Google Cloud Console → Credentials → Authorized JavaScript origins:
#   http://localhost:3000
#   http://127.0.0.1:3000
#   https://<your-production-site>
GOOGLE_CLIENT_ID=343746941144-ucvr6cnrsi85fopbqjmsd7voc1ucgdig.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=343746941144-ucvr6cnrsi85fopbqjmsd7voc1ucgdig.apps.googleusercontent.com

# Email (Phase 5 logs in development; provider later)
# EMAIL_PROVIDER=
# EMAIL_FROM=noreply@apicaptain.dev

# Web (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
