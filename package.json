{
  "name": "apicaptain",
  "private": true,
  "version": "0.0.0",
  "description": "ApiCaptain — Turn APIs into production-ready code.",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @apicaptain/api db:generate",
    "db:migrate": "pnpm --filter @apicaptain/api db:migrate",
    "db:migrate:dev": "pnpm --filter @apicaptain/api db:migrate:dev",
    "db:studio": "pnpm --filter @apicaptain/api db:studio",
    "db:seed": "pnpm --filter @apicaptain/api db:seed"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@tailwindcss/oxide",
      "@prisma/engines",
      "prisma"
    ]
  }
}
