{
  "name": "@apicaptain/api",
  "version": "0.0.0",
  "private": true,
  "description": "ApiCaptain Express API",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "node ../../scripts/with-root-env.mjs tsx watch src/index.ts",
    "build": "node ../../scripts/with-root-env.mjs prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "SAAS_STORE=memory NODE_ENV=test RAZORPAY_KEY_ID=rzp_test_dummy RAZORPAY_KEY_SECRET=test_secret RAZORPAY_WEBHOOK_SECRET=test_webhook_secret RAZORPAY_PRO_PLAN_ID=plan_test_pro node --import tsx --test src/__tests__/api.test.ts src/__tests__/saas.test.ts src/__tests__/billing.test.ts src/__tests__/prismaErrors.test.ts",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "db:generate": "node ../../scripts/with-root-env.mjs prisma generate",
    "db:migrate": "node ../../scripts/with-root-env.mjs prisma migrate deploy",
    "db:migrate:dev": "node ../../scripts/with-root-env.mjs prisma migrate dev",
    "db:studio": "node ../../scripts/with-root-env.mjs prisma studio",
    "db:seed": "node ../../scripts/with-root-env.mjs tsx prisma/seed.ts",
    "db:url-info": "node ../../scripts/db-url-info.mjs"
  },
  "dependencies": {
    "@apicaptain/billing": "workspace:*",
    "@apicaptain/config": "workspace:*",
    "@apicaptain/generators": "workspace:*",
    "@apicaptain/openapi": "workspace:*",
    "@apicaptain/types": "workspace:*",
    "@prisma/client": "^6.8.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^10.9.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.21",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
