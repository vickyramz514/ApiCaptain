generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserPlan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
  INACTIVE
  EXPIRED
}

enum SubscriptionProvider {
  NONE
  RAZORPAY
  STRIPE
}

enum GenerationStatus {
  SUCCESS
  FAILED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

/// Authenticated ApiCaptain account
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  /// Null for Google-only accounts
  passwordHash String?
  /// email | google
  authProvider String    @default("email")
  googleSub    String?   @unique
  plan         UserPlan  @default(FREE)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  projects         Project[]
  generations      Generation[]
  sessions         Session[]
  passwordResets   PasswordResetToken[]
  usageRecords     UsageRecord[]
  subscriptions    Subscription[]
  payments         Payment[]

  @@index([email])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ipAddress String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Saved workspace/project owned by a single user
model Project {
  id              String    @id @default(cuid())
  userId          String
  name            String
  description     String?
  /// JSON | API | OPENAPI
  sourceType      String
  sourceContent   String?   @db.Text
  /// Extra structured source (method/endpoint/json samples, selected endpoints, etc.)
  sourceMeta      Json?
  openApiVersion  String?
  framework       String?
  library         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastGeneratedAt DateTime?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  generations Generation[]

  @@index([userId])
  @@index([updatedAt])
  @@map("projects")
}

/// Generation history (full generated code is not persisted by default)
model Generation {
  id            String           @id @default(cuid())
  projectId     String?
  userId        String?
  /// json | api | openapi (legacy) or JSON | API | OPENAPI
  sourceType    String           @default("json")
  sourceName    String?
  specVersion   String?
  framework     String?
  language      String?
  library       String?
  endpointCount Int?
  status        GenerationStatus @default(SUCCESS)
  durationMs    Int?
  inputJson     Json             @default("{}")
  rootName      String           @default("")
  outputType    String           @default("")
  /// Kept for compatibility; prefer regenerating from project source
  generatedCode String           @default("")
  metadata      Json?
  createdAt     DateTime         @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([createdAt])
  @@index([sourceType])
  @@index([status])
  @@map("generations")
}

/// Monthly usage counters per user
model UsageRecord {
  id              String   @id @default(cuid())
  userId          String
  /// YYYY-MM
  period          String
  generationCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@index([userId])
  @@map("usage_records")
}

/// Payment-provider subscription (Razorpay is live in Phase 6)
model Subscription {
  id                     String               @id @default(cuid())
  userId                 String
  plan                   UserPlan             @default(FREE)
  status                 SubscriptionStatus   @default(INACTIVE)
  provider               SubscriptionProvider @default(NONE)
  providerCustomerId     String?
  providerSubscriptionId String?
  providerPlanId         String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean              @default(false)
  cancelledAt            DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId])
  @@index([status])
  @@index([providerCustomerId])
  @@index([provider, providerSubscriptionId])
  @@map("subscriptions")
}

/// Captured billing transactions (amounts in minor units / paise)
model Payment {
  id                 String               @id @default(cuid())
  userId             String
  subscriptionId     String?
  provider           SubscriptionProvider @default(RAZORPAY)
  providerPaymentId  String
  providerOrderId    String?
  amount             Int
  currency           String               @default("INR")
  status             PaymentStatus        @default(CREATED)
  paymentMethod      String?
  invoiceUrl         String?
  paidAt             DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([provider, providerPaymentId])
  @@index([userId])
  @@index([subscriptionId])
  @@index([createdAt])
  @@map("payments")
}

/// Idempotent webhook receipts
model WebhookEvent {
  id            String               @id @default(cuid())
  provider      SubscriptionProvider
  eventId       String
  eventType     String
  payloadHash   String
  processed     Boolean              @default(false)
  processedAt   DateTime?
  failureReason String?
  createdAt     DateTime             @default(now())

  @@unique([provider, eventId])
  @@index([processed])
  @@index([eventType])
  @@map("webhook_events")
}
